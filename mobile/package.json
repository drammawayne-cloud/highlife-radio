{
  "name": "highlife-radio-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "test": "tsx --test tests/*.test.ts",
    "lint": "expo lint",
    "build:all": "expo export --platform all --output-dir dist-all",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npm run release:check && npx eas-cli@latest submit --platform ios --profile production",
    "postinstall": "node scripts/patch-query-string.cjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2"
  },
  "overrides": {
    "decode-uri-component": "0.5.0"
  }
}
